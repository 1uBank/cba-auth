# Copy to .env for a local run. Never commit .env.
# On AWS these values come from Secrets Manager.

KC_DB_NAME=auth
KC_DB_USERNAME=auth
KC_DB_PASSWORD=

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

PORTAL_URL=http://localhost:4200

# First-login migration of existing CBA-CORE staff.
CBA_CORE_MIGRATION_ENABLED=false
# CBA-CORE API as the auth service container reaches it, e.g. https://host.docker.internal:8443/fineract-provider/api/v1
CBA_CORE_MIGRATION_API_URL=