# Copy to .env for a local run. Never commit .env.
# On AWS these values come from Secrets Manager.

KC_DB_NAME=auth
KC_DB_USERNAME=auth
KC_DB_PASSWORD=

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

PORTAL_URL=http://localhost:4200

BANKING_API_CLIENT_SECRET=
PAYMENTS_CLIENT_SECRET=
COMPLIANCE_CLIENT_SECRET=
USER_PROVISIONER_SECRET=
USER_MIGRATOR_SECRET=
APP_CLIENT_SECRET=
IRECHARGE_CLIENT_SECRET=

# First-login migration of existing Fineract staff (true while staff are moving across).
FINERACT_MIGRATION_ENABLED=false
# CBA-CORE API as the auth service container reaches it, e.g. https://host.docker.internal:8443/fineract-provider/api/v1
FINERACT_MIGRATION_API_URL=
